# Telegram bot token. Required for validating Mini App initData.
TELEGRAM_BOT_TOKEN=

# Public HTTPS address of the deployed Mini App (used by the Telegram bot).
VORTEX_WEBAPP_URL=https://your-vortex-service.onrender.com

# Optional: use local demo orders without ai-product.
VORTEX_DEMO_MODE=false

# Optional: database URL. On Render use a managed PostgreSQL URL for durable profiles/favorites.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Development-only shortcut. MUST remain false on Render/production.
VORTEX_DEV_AUTH=false
VORTEX_DEV_TELEGRAM_ID=100000001

# Existing ai-product integration; unchanged.
PRODUCT_API_BASE_URL=http://127.0.0.1:8000
PRODUCT_API_KEY=
CHANNEL_FORWARD_ENABLED=false
TELEGRAM_BOT_WEBHOOK_SECRET=
